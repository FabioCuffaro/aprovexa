# Local PostgreSQL configuration for Docker Compose.
# Copy this file to .env before starting infrastructure.
POSTGRES_DB=aprovexa
POSTGRES_USER=aprovexa
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# V3 JWT configuration for the Spring Boot process.
# Do NOT commit a real secret. JWT_SECRET must be at least 32 UTF-8 bytes.
JWT_SECRET=CHANGE_ME
JWT_ISSUER=aprovexa
JWT_ACCESS_TOKEN_TTL=PT30M
